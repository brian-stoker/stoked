{
  "name": "stoked-mono",
  "version": "0.0.1-a.0",
  "description": "stoked about all the things",
  "main": "\"echo 'no entry point in root'\"",
  "scripts": {
    "clean": "rimraf --glob '**/node_modules' '**/pnpm-lock.yaml' '**/.turbo' '**/package-lock.json' '**/yarn.lock' '**/.sst' '**/.next' '**/build' '**/dist'",
    "clean:test": "rimraf --glob '**/test/reports/artifacts'",
    "cli:test": "pnpm -F @stoked/cli test",
    "cli:test:unit": "pnpm -F @stoked/cli test:unit",
    "cli:test:integration": "pnpm -F @stoked/cli test:integration",
    "cli:test:e2e": "pnpm -F @stoked/cli test:e2e",
    "cli:test:ui": "pnpm -F @stoked/cli test:ui",
    "cli:test:complete": "pnpm -F @stoked/cli test:complete"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brian-stoker/stoked.git"
  },
  "keywords": [
    "local-llm",
    "ollama",
    "cli",
    "stoked"
  ],
  "author": "Brian Stoker",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brian-stoker/stoked/issues"
  },
  "homepage": "https://github.com/brian-stoker/stoked#readme",
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/glob": "^8.1.0",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "3.1.1"
  },
  "pnpm": {
    "overrides": {}
  },
  "dependencies": {
    "stoked": "link:packages/cli"
  }
}
