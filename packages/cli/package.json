{
  "name": "@stoked/cli",
  "version": "0.0.1-a.0",
  "description": "",
  "author": "Brian Stoker (w/ help from Claude)",
  "bin": {
    "stoked": "dist/main.js"
  },
  "main": "dist/main.js",
  "private": true,
  "license": "MIT",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && nest build && chmod +x dist/main.js && pnpm unlink --global && pnpm link --global",
    "fix:decorators": "tsx scripts/fix-decorator-issues.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "fix-imports": "node src/fix-imports.mjs",
    "dev": "NODE_OPTIONS='--no-warnings --loader ts-node/esm' ts-node --project tsconfig.node.json src/main.ts",
    "debug": "NODE_OPTIONS='--no-warnings --loader ts-node/esm --experimental-specifier-resolution=node --inspect-brk' ts-node --project tsconfig.node.json src/main.ts",
    "debug:cmd": "NODE_OPTIONS='--no-warnings --experimental-specifier-resolution=node --inspect-brk --enable-source-maps' node src/debug-helper.mjs",
    "debug:mjs": "node --no-warnings --inspect-brk --enable-source-maps src/debug-helper.mjs",
    "debug:minimal": "node --no-warnings --inspect-brk --enable-source-maps src/debug-minimal.mjs",
    "debug:direct": "node --no-warnings --inspect-brk --enable-source-maps src/direct-debug.mjs",
    "debug:direct:no-inspect": "node --no-warnings src/direct-debug.mjs",
    "debug:simple": "node --no-warnings --inspect-brk --enable-source-maps src/simple-debug.mjs",
    "debug:simple:no-inspect": "node --no-warnings src/simple-debug.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "tsx scripts/run-all-tests.ts",
    "test:unit:old": "tsx -e \"import { createArtifactDir } from './scripts/setup-test-artifacts.ts'; createArtifactDir('unit')\" && NODE_OPTIONS='--max-old-space-size=8192' vitest run \"test/unit/\" -c test/unit/unit.config.ts",
    "test:unit": "tsx  scripts/run-unit-tests.ts",
    "test:integration:old": "tsx -e \"import { createArtifactDir } from './scripts/setup-test-artifacts.ts'; createArtifactDir('integration')\" && NODE_OPTIONS='--max-old-space-size=8192' vitest run \"test/integration/\" -c test/integration/integration.config.ts",
    "test:integration": "tsx  scripts/run-integration-tests.ts",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:ui": "npx serve test/reports",
    "test:complete": "pnpm test && pnpm test:ui"
  },
  "dependencies": {
    "@actions/github": "^6.0.0",
    "@babel/parser": "^7.27.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.13",
    "@nestjs/cqrs": "^11.0.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@octokit/rest": "^21.1.1",
    "@octokit/types": "^13.8.0",
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.8.3",
    "bcrypt": "^5.1.1",
    "chalk": "^5.4.1",
    "class-validator": "^0.14.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.2",
    "glob": "^11.0.1",
    "js-yaml": "^4.1.0",
    "nest-commander": "^3.17.0",
    "octokit": "^4.1.2",
    "ollama": "^0.5.14",
    "process": "^0.11.10",
    "readline": "^1.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/runtime": "^7.24.8",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.51.1",
    "@pnpm/link-bins": "^1000.0.8",
    "@stoked-ui/common": "0.1.3-a.0",
    "@stoked-ui/media-selector": "0.1.4-a.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/glob": "^8.1.0",
    "@types/node": "^22.10.7",
    "@types/node-fetch": "^2.6.12",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "3.1.1",
    "@vitest/ui": "3.1.1",
    "c8": "^10.1.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "ignore": "^7.0.0",
    "node-fetch": "3.3.2",
    "playwright": "^1.51.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.1.1",
    "yargs-parser": "^21.1.1"
  }
}